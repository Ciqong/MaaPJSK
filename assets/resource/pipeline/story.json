{
    "RunStoryHelper": {
        "timeout": -1,
        "rate_limit": 600,
        "next": [
            "[JumpBack]HandleNetworkError",
            "[JumpBack]HandleDownloadButton",
            "[JumpBack]OpenStoryFromMainPage",
            "[JumpBack]OpenMainStoryPage",
            "[JumpBack]SetUnreadStoryFilter",
            "[JumpBack]ContinueStoryListAndReadChapterTabs",
            "[JumpBack]ContinueStoryListAndRead",
            "[JumpBack]ContinueStoryListAndReadInfoButton",
            "[JumpBack]OpenStoryListAndRead"
        ]
    },

    "HandleNetworkError": {
        "recognition": "TemplateMatch",
        "template": "network_error_retryable.png",
        "roi": [360, 250, 560, 220],
        "threshold": 0.86,
        "action": "Click",
        "target": [762, 424],
        "post_delay": 2000
    },

    "HandleDownloadButton": {
        "recognition": "TemplateMatch",
        "template": "download_button.png",
        "roi": [650, 440, 500, 180],
        "threshold": 0.82,
        "action": "Click",
        "target": true,
        "post_delay": 2500
    },

    "OpenStoryFromMainPage": {
        "recognition": "TemplateMatch",
        "template": "main_page_story_btn.png",
        "roi": [-460, -130, 420, 130],
        "threshold": 0.55,
        "action": "Click",
        "target": true,
        "post_delay": 1200
    },

    "OpenMainStoryPage": {
        "recognition": "TemplateMatch",
        "template": "main_story_btn.png",
        "roi": [120, 100, 950, 340],
        "threshold": 0.82,
        "action": "Click",
        "target": true,
        "post_delay": 1200
    },

    "SetUnreadStoryFilter": {
        "recognition": "TemplateMatch",
        "template": "filter_button.png",
        "roi": [-500, 0, 420, 90],
        "threshold": 0.78,
        "max_hit": 1,
        "action": "Custom",
        "custom_action": "set_unread_story_filter",
        "custom_action_param": {
            "filter_option_ratio": [0.521, 0.333],
            "filter_confirm_ratio": [0.594, 0.907],
            "click_delay": 0.8
        },
        "post_delay": 1200
    },

    "OpenStoryListAndRead": {
        "recognition": "TemplateMatch",
        "template": "story_home_confirm.png",
        "roi": [-470, -120, 420, 120],
        "threshold": 0.74,
        "action": "Custom",
        "custom_action": "filter_unread_and_open_story",
        "custom_action_param": {
            "story_home_confirm_node": "FlagStoryHomeConfirm",
            "story_home_filter_button_ratio": [0.752, 0.063],
            "story_home_filter_option_ratio": [0.521, 0.333],
            "story_home_filter_confirm_ratio": [0.594, 0.907],
            "story_home_filter_delay": 0.8,
            "story_home_after_filter_wait": 1.0,
            "story_home_confirm_retries": 2,
            "story_home_confirm_retry_delay": 0.8,
            "story_home_card_points": [[405, 360], [350, 505], [350, 620]],
            "story_home_card_crop_size": [220, 90],
            "story_home_card_min_std": 18.0,
            "story_home_card_min_mean": 18.0,
            "no_unread_stop_node": "StopNoUnreadStory"
        },
        "post_delay": 1000,
        "next": [
            "FindAndReadNextUnreadStory"
        ]
    },

    "ContinueStoryListAndRead": {
        "recognition": "TemplateMatch",
        "template": "skip_badge.png",
        "roi": [-430, 120, 410, 570],
        "threshold": 0.86,
        "action": "DoNothing",
        "post_delay": 200,
        "next": [
            "FindAndReadNextUnreadStory"
        ]
    },

    "ContinueStoryListAndReadChapterTabs": {
        "recognition": "TemplateMatch",
        "template": "story_chapter_tabs.png",
        "roi": [-760, 70, 700, 80],
        "threshold": 0.78,
        "action": "DoNothing",
        "post_delay": 200,
        "next": [
            "FindAndReadNextUnreadStory"
        ]
    },

    "ContinueStoryListAndReadInfoButton": {
        "recognition": "TemplateMatch",
        "template": "story_info_button.png",
        "roi": [-280, 130, 260, 560],
        "threshold": 0.76,
        "action": "DoNothing",
        "post_delay": 200,
        "next": [
            "FindAndReadNextUnreadStory"
        ]
    },

    "ScrollStoryListToBottom": {
        "action": "Swipe",
        "begin": [933, 633],
        "end": [933, 20],
        "duration": 120,
        "repeat": 3,
        "repeat_delay": 150,
        "post_delay": 800,
        "next": [
            "FindAndReadNextUnreadStory"
        ]
    },

    "FindAndReadNextUnreadStory": {
        "action": "Custom",
        "custom_action": "find_and_read_next_unread_story",
        "custom_action_param": {
            "story_row_points": [
